<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/preview_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/preview_hero_card"
        style="@style/Widget.Powertv.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:contentPadding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/preview_hero_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:text="@string/dashboard_hero_label"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_live"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/preview_hero_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:tag="powertv_metric"
                android:text="@string/theme_preview_device"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/preview_hero_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.8"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="12sp"
                tools:text="Android 16 · arm64-v8a · up 3h 12m" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Powertv.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:contentPadding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_cpu_title"
                    android:textAppearance="@style/TextAppearance.Powertv.SectionLabel" />

                <TextView
                    android:id="@+id/preview_metric_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="powertv_metric"
                    android:text="42%"
                    android:textAppearance="@style/TextAppearance.Powertv.MetricSmall" />
            </LinearLayout>

            <com.zitzhen.powertv.ui.widget.SparklineView
                android:id="@+id/preview_chart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/preview_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:progress="42"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorSurfaceContainerHighest"
                app:trackThickness="6dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/preview_pill_primary"
                    style="@style/Widget.Powertv.Pill.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="powertv_pill_primary"
                    android:text="@string/status_live"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/preview_pill_surface"
                    style="@style/Widget.Powertv.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:tag="powertv_pill_surface"
                    android:text="@string/dashboard_gpu_available"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/preview_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/theme_preview_caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/preview_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/theme_contrast_warning"
        android:textColor="?attr/colorError"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/preview_compat_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="?attr/colorError"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="This pack targets a newer power-tv version."
        tools:visibility="visible" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/preview_apply_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/theme_apply_layout"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
